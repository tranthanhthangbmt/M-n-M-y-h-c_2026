</v:shape></span><![endif]><span style='mso-bookmark:response-39'><span
lang=EN-US><span style='mso-spacerun:yes'> </span>trường hợp với </span></span><span
style='mso-bookmark:response-39'></span><!--[if gte msEquation 12]><m:oMath><span
 style='mso-bookmark:response-39'><m:r><i style='mso-bidi-font-style:normal'><span
