mso-bidi-font-family:"Times New Roman";mso-bidi-theme-font:minor-bidi;
mso-ansi-language:VI;mso-fareast-language:VI;mso-bidi-language:AR-SA'><v:shape
 id="_x0000_i1025" type="#_x0000_t75" style='width:104.25pt;height:23.25pt'>
 <v:imagedata src="Hands-On%20Machine%20Learning%20with%20ScikitLearn,%20Keras,%20and%20TensorFlow2_files/image193.png"
  o:title="" chromakey="white"/>
</v:shape></span><![endif]><span style='mso-bookmark:response-37'></span></p>

<p class=MsoBodyText style='text-align:justify'><span style='mso-bookmark:response-37'><span
lang=EN-US>Dưới đây là cách thực hiện hồi quy Ridge với Scikit-Learn bằng cách
sử dụng giải pháp dạng đóng (một biến thể của Phương trình 4-9 sử dụng kỹ thuật
phân tách ma trận của André-Louis Cholesky):</span></span></p>

<p class=SourceCode><span style='mso-bookmark:response-37'><span
class=VerbatimChar><span lang=EN-US style='font-size:11.0pt;mso-bidi-font-size:
12.0pt;color:black;mso-color-alt:windowtext'>from sklearn.linear_model import
Ridge</span></span><span lang=EN-US style='color:black;mso-color-alt:windowtext'><br>
<br>
</span></span><span style='mso-bookmark:response-37'><span class=VerbatimChar><span
lang=EN-US style='font-size:11.0pt;mso-bidi-font-size:12.0pt;color:black;
mso-color-alt:windowtext'>ridge_reg = Ridge(alpha=0.1,
solver=&quot;cholesky&quot;)</span></span><span lang=EN-US style='color:black;
mso-color-alt:windowtext'><br>
</span></span><span style='mso-bookmark:response-37'><span class=VerbatimChar><span
lang=EN-US style='font-size:11.0pt;mso-bidi-font-size:12.0pt;color:black;
mso-color-alt:windowtext'>ridge_reg.fit(X, y)</span></span><span lang=EN-US
style='color:black;mso-color-alt:windowtext'><br>
</span></span><span style='mso-bookmark:response-37'><span class=VerbatimChar><span
lang=EN-US style='font-size:11.0pt;mso-bidi-font-size:12.0pt;color:black;
mso-color-alt:windowtext'>ridge_reg.predict([[1.5]])</span></span><span
lang=EN-US style='color:black;mso-color-alt:windowtext'><br>
</span></span><span style='mso-bookmark:response-37'><span class=VerbatimChar><span
lang=EN-US style='font-size:11.0pt;mso-bidi-font-size:12.0pt;color:black;
mso-color-alt:windowtext'># Output: array([[1.55325833]])</span></span></span></p>

<p class=FirstParagraph style='text-align:justify'><span style='mso-bookmark:
response-37'><span lang=EN-US>Và sử dụng stochastic gradient descent:</span></span></p>

<p class=SourceCode><span style='mso-bookmark:response-37'><span
class=VerbatimChar><span lang=EN-US style='font-size:11.0pt;mso-bidi-font-size:
12.0pt;color:black;mso-color-alt:windowtext'>from sklearn.linear_model import
SGDRegressor</span></span><span lang=EN-US style='color:black;mso-color-alt:
windowtext'><br>
<br>
</span></span><span style='mso-bookmark:response-37'><span class=VerbatimChar><span
lang=EN-US style='font-size:11.0pt;mso-bidi-font-size:12.0pt;color:black;
mso-color-alt:windowtext'>sgd_reg = SGDRegressor(penalty=&quot;l2&quot;,
alpha=0.1 / m, tol=None,</span></span><span lang=EN-US style='color:black;
mso-color-alt:windowtext'><br>
</span></span><span style='mso-bookmark:response-37'><span class=VerbatimChar><span
lang=EN-US style='font-size:11.0pt;mso-bidi-font-size:12.0pt;color:black;
mso-color-alt:windowtext'><span style='mso-spacerun:yes'>                      
</span>max_iter=1000, eta0=0.01, random_state=42)</span></span><span
lang=EN-US style='color:black;mso-color-alt:windowtext'><br>
</span></span><span style='mso-bookmark:response-37'><span class=VerbatimChar><span
lang=EN-US style='font-size:11.0pt;mso-bidi-font-size:12.0pt;color:black;
mso-color-alt:windowtext'>sgd_reg.fit(X, y.ravel()) # y.ravel() because fit()
expects 1D targets</span></span><span lang=EN-US style='color:black;mso-color-alt:
windowtext'><br>
</span></span><span style='mso-bookmark:response-37'><span class=VerbatimChar><span
lang=EN-US style='font-size:11.0pt;mso-bidi-font-size:12.0pt;color:black;
mso-color-alt:windowtext'>sgd_reg.predict([[1.5]])</span></span><span
lang=EN-US style='color:black;mso-color-alt:windowtext'><br>
</span></span><span style='mso-bookmark:response-37'><span class=VerbatimChar><span
lang=EN-US style='font-size:11.0pt;mso-bidi-font-size:12.0pt;color:black;
mso-color-alt:windowtext'># Output: array([1.55302613])</span></span></span></p>

<p class=FirstParagraph style='text-align:justify'><span style='mso-bookmark:
response-37'><span lang=EN-US>Siêu tham số </span></span><span
style='mso-bookmark:response-37'><span class=VerbatimChar><span lang=EN-US
style='font-size:11.0pt;mso-bidi-font-size:12.0pt'>penalty</span></span><span
lang=EN-US> đặt loại thuật ngữ chính quy hóa sẽ sử dụng. Việc chỉ định “l2” cho
biết bạn muốn SGD thêm một thuật ngữ chính quy hóa vào hàm chi phí MSE bằng </span></span><span
style='mso-bookmark:response-37'><span class=VerbatimChar><span lang=EN-US
style='font-size:11.0pt;mso-bidi-font-size:12.0pt'>alpha</span></span><span
lang=EN-US> nhân với bình phương chuẩn </span></span><span style='mso-bookmark:
response-37'></span><!--[if gte msEquation 12]><m:oMath><span style='mso-bookmark:
 response-37'><m:r><i style='mso-bidi-font-style:normal'><span lang=EN-US
  style='font-family:"Cambria Math",serif'>el</span></i></m:r></span><span
 style='mso-bookmark:response-37'></span><m:sSub><m:sSubPr><span
   style='font-family:"Cambria Math",serif;mso-ascii-font-family:"Cambria Math";
   mso-hansi-font-family:"Cambria Math"'><m:ctrlPr></m:ctrlPr></span></m:sSubPr><m:e><span
   style='mso-bookmark:response-37'><m:r><i style='mso-bidi-font-style:normal'><span
    lang=EN-US style='font-family:"Cambria Math",serif'>l</span></i></m:r></span><span
   style='mso-bookmark:response-37'></span></m:e><m:sub><span style='mso-bookmark:
   response-37'><m:r><i style='mso-bidi-font-style:normal'><span lang=EN-US
    style='font-family:"Cambria Math",serif'>2</span></i></m:r></span><span
   style='mso-bookmark:response-37'></span></m:sub></m:sSub></m:oMath><![endif]--><![if !msEquation]><span
style='font-size:12.0pt;line-height:115%;font-family:"Arial",sans-serif;
mso-ascii-theme-font:minor-latin;mso-fareast-font-family:"Times New Roman";
mso-fareast-theme-font:minor-fareast;mso-hansi-theme-font:minor-latin;
mso-bidi-font-family:"Times New Roman";mso-bidi-theme-font:minor-bidi;
position:relative;top:3.0pt;mso-text-raise:-3.0pt;mso-ansi-language:VI;
mso-fareast-language:VI;mso-bidi-language:AR-SA'><v:shape id="_x0000_i1025"
 type="#_x0000_t75" style='width:19.5pt;height:23.25pt'>
 <v:imagedata src="Hands-On%20Machine%20Learning%20with%20ScikitLearn,%20Keras,%20and%20TensorFlow2_files/image194.png"
  o:title="" chromakey="white"/>
</v:shape></span><![endif]><span style='mso-bookmark:response-37'><span
lang=EN-US><span style='mso-spacerun:yes'> </span>của vector trọng số. Điều này
giống như hồi quy Ridge, ngoại trừ trong trường hợp này không có phép chia cho </span></span><span
style='mso-bookmark:response-37'><span class=VerbatimChar><span lang=EN-US
style='font-size:11.0pt;mso-bidi-font-size:12.0pt'>m</span></span><span
lang=EN-US>; đó là lý do tại sao chúng ta truyền </span></span><span
style='mso-bookmark:response-37'><span class=VerbatimChar><span lang=EN-US
style='font-size:11.0pt;mso-bidi-font-size:12.0pt'>alpha=0.1 / m</span></span><span
lang=EN-US>, để có cùng kết quả như </span></span><span style='mso-bookmark:
response-37'><span class=VerbatimChar><span lang=EN-US style='font-size:11.0pt;
mso-bidi-font-size:12.0pt'>Ridge(alpha=0.1)</span></span><span lang=EN-US>.</span></span></p>

<h4 style='text-align:justify'><span style='mso-bookmark:response-37'><a
name="_Toc205158698"><span lang=EN-US>4.5.2 Hồi quy Lasso</span></a><span
lang=EN-US> </span></span></h4>

