mso-color-alt:windowtext'>0<span style='mso-spacerun:yes'>    </span>0</span></span><span
lang=EN-US style='color:black;mso-color-alt:windowtext'><br>
</span></span><span style='mso-bookmark:response-39'><span class=VerbatimChar><span
lang=EN-US style='font-size:11.0pt;mso-bidi-font-size:12.0pt;color:black;
mso-color-alt:windowtext'>1<span style='mso-spacerun:yes'>    </span>0</span></span><span
lang=EN-US style='color:black;mso-color-alt:windowtext'><br>
</span></span><span style='mso-bookmark:response-39'><span class=VerbatimChar><span
lang=EN-US style='font-size:11.0pt;mso-bidi-font-size:12.0pt;color:black;
mso-color-alt:windowtext'>2<span style='mso-spacerun:yes'>    </span>0</span></span><span
lang=EN-US style='color:black;mso-color-alt:windowtext'><br>
</span></span><span style='mso-bookmark:response-39'><span class=VerbatimChar><span
lang=EN-US style='font-size:11.0pt;mso-bidi-font-size:12.0pt;color:black;
mso-color-alt:windowtext'>Name: target, dtype: int64</span></span><span
