class=VerbatimChar><span lang=EN-US style='font-size:11.0pt;mso-bidi-font-size:
12.0pt;color:black;mso-color-alt:windowtext'><span
style='mso-spacerun:yes'>       
</span>Path(&quot;datasets&quot;).mkdir(parents=True, exist_ok=True)</span></span><span
